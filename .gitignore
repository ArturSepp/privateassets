# --- Private sub-trees: developed alongside, never part of the public package ---
/projects/
/data/

# --- Generated outputs ---
/outputs/*
!/outputs/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
/docs/_build/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# --- OS / IDE ---
.DS_Store
.idea/

# --- Never commit ---
*.zip
*.xlsx
*.xls
*.csv
