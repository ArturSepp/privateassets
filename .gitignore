# --- Private sub-trees: developed alongside, never part of the public package ---
/projects/
/data/

# --- Generated outputs ---
/outputs/*
!/outputs/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
/docs/_build/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# --- OS / IDE ---
.DS_Store
.idea/

# --- Never commit ---
*.zip
*.xlsx
*.xls
*.csv

# Local agent roadmaps and working outputs
/agents/

# All paper workspaces are local; only the shared policy and index are tracked.
/papers/*
!/papers/AGENTS.md
!/papers/README.md
/papers/**/drafts/
/papers/**/private/
/papers/**/agents/
/papers/**/paper/**
/papers/**/presentations/**
/papers/**/replication/data/
/papers/**/replication/results/
/papers/**/replication/outputs/
