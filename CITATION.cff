version: 0.4.0
date-released: "2026-07-26"
license: MIT
repository-code: "https://github.com/ArturSepp/privateassets"
keywords:
  - private equity
  - private credit
  - public market equivalent
  - direct alpha
  - money-weighted returns
  - unsmoothing
